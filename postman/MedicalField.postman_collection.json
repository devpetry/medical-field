        {
          "name": "Sem token deve dar 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Device-Id",
                "value": "{{deviceId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pessoa",
              "host": [

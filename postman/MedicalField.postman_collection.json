{
  "info": {
    "name": "MedicalField",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Rotas do MedicalField via Nginx. Rode 'POST /auth/login' primeiro: o token fica em {{token}}."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1/api"
    },
    {
      "key": "senha",
      "value": "MedField@2026"
    },
    {
      "key": "deviceId",
      "value": "postman"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "tokenAdmin",
      "value": ""
    },
    {
      "key": "pessoaId",
      "value": ""
    },
    {
      "key": "prontuarioId",
      "value": ""
    },
    {
      "key": "atendimentoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "auth-service (Node.js)",
      "item": [
        {
          "name": "POST /auth/login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Device-Id",
                "value": "{{deviceId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registro\": \"CRM-RS 12345\",\n  \"tipoRegistro\": \"CRM\",\n  \"senha\": \"{{senha}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Única rota pública. Guarda o token e gera os UUIDs usados nos POST seguintes."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().accessToken);",
                  "pm.collectionVariables.set('pessoaId', pm.variables.replaceIn('{{$randomUUID}}'));",
                  "pm.collectionVariables.set('prontuarioId', pm.variables.replaceIn('{{$randomUUID}}'));",
                  "pm.collectionVariables.set('atendimentoId', pm.variables.replaceIn('{{$randomUUID}}'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/login (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Device-Id",
                "value": "{{deviceId}}"
              },
              {

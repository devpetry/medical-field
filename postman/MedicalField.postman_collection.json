              "mode": "raw",
              "raw": "{\n  \"registro\": \"CRM-RS 99999\",\n  \"tipoRegistro\": \"CRM\",\n  \"senha\": \"{{senha}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Única rota pública. Guarda o token e gera os UUIDs usados nos POST seguintes."

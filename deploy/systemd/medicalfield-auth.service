[Unit]
Description=MedicalField auth-service (Node.js)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=medicalfield
WorkingDirectory=/opt/medicalfield/auth
EnvironmentFile=/opt/medicalfield/auth/.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
